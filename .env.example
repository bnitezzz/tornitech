# Variables de entorno — Tornitech

Copia este archivo como `.env.local` y completa los valores.

# ─── Supabase ───────────────────────────────────────────────
# URL y clave pública (publishable o anon legacy). También en Netlify.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Legacy (opcional si ya usas publishable key):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role: SOLO servidor. Obligatoria para formularios (INSERT público deshabilitado).
# En Netlify → Site settings → Environment variables (nunca marcar como NEXT_PUBLIC).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Sitio ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://ccstornitech.com
NEXT_PUBLIC_WHATSAPP=584242818062
# HMAC para enlaces PDF temporales (mínimo 32 caracteres; generar con `openssl rand -base64 48`).
# Si se omite, el servidor usa SUPABASE_SERVICE_ROLE_KEY como fallback.
CATALOG_DOWNLOAD_SECRET=replace-with-a-random-server-only-secret

# ─── Email (SendGrid) ───────────────────────────────────────
# Cuenta en https://sendgrid.com — ideal para transaccional + campañas marketing.
# En Netlify: marcar SENDGRID_API_KEY como "Secret".
SENDGRID_API_KEY=SG.xxxxxxxx
EMAIL_FROM="CCS Tornitech C.A. <info@ccstornitech.com>"
# Correo corporativo del cliente (para scripts update:site-config y verificación)
# CLIENT_CONTACT_EMAIL=info@ccstornitech.com

# ─── Rate limiting (opcional, recomendado) ──────────────────
# Si no se configuran, el fallback usa Supabase (migración 005).
# Crear base gratuita en https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Checklist Netlify (Sprint 1 P0) ────────────────────────
# [ ] NEXT_PUBLIC_SUPABASE_URL
# [ ] NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (o ANON_KEY)
# [ ] SUPABASE_SERVICE_ROLE_KEY (solo servidor, nunca en cliente)
# [ ] NEXT_PUBLIC_SITE_URL=https://ccstornitech.com
# [ ] NEXT_PUBLIC_WHATSAPP=584242818062
# [ ] CATALOG_DOWNLOAD_SECRET (solo servidor)
# [ ] SENDGRID_API_KEY (clave real, no placeholder)
# [ ] EMAIL_FROM / EMAIL_TO
# [ ] UPSTASH_REDIS_REST_URL + TOKEN (opcional)
# Verificar local: npm run verify:sprint1
