# Variables de entorno — Tornitech

Copia este archivo como `.env.local` y completa los valores.

# ─── Supabase ───────────────────────────────────────────────
# URL y clave pública (publishable o anon legacy). También en Netlify.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Legacy (opcional si ya usas publishable key):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role: SOLO servidor. Obligatoria para formularios (INSERT público deshabilitado).
# En Netlify → Site settings → Environment variables (nunca marcar como NEXT_PUBLIC).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Sitio ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://ccstornitech.com
NEXT_PUBLIC_WHATSAPP=584242818062

# ─── Email (Resend) ─────────────────────────────────────────
# Obtén tu API key en https://resend.com
# En Netlify: marcar como "Secret" y scope "All" o "Production".
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="CCS Tornitech C.A. <noreply@tornitech.com>"
EMAIL_TO=info@tornitech.com

# ─── Rate limiting (opcional, recomendado) ──────────────────
# Si no se configuran, el fallback usa Supabase (migración 005).
# Crear base gratuita en https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Checklist Netlify (Sprint 1 P0) ────────────────────────
# [ ] NEXT_PUBLIC_SUPABASE_URL
# [ ] NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (o ANON_KEY)
# [ ] SUPABASE_SERVICE_ROLE_KEY (solo servidor, nunca en cliente)
# [ ] NEXT_PUBLIC_SITE_URL=https://ccstornitech.com
# [ ] NEXT_PUBLIC_WHATSAPP=584242818062
# [ ] RESEND_API_KEY (clave real, no placeholder)
# [ ] EMAIL_FROM / EMAIL_TO
# [ ] UPSTASH_REDIS_REST_URL + TOKEN (opcional)
# Verificar local: npm run verify:sprint1
