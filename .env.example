# Variables de entorno — Tornitech

Copia este archivo como `.env.local` y completa los valores.

# ─── Supabase ───────────────────────────────────────────────
# URL y clave pública (publishable o anon legacy). También en Netlify.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Legacy (opcional si ya usas publishable key):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role: solo servidor. En Netlify → Site settings → Environment variables.
# Si falta, los formularios usan la clave pública con políticas RLS de INSERT.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Sitio ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://tornitech.com
NEXT_PUBLIC_WHATSAPP=584121234567

# ─── Email (Resend) ─────────────────────────────────────────
# Obtén tu API key en https://resend.com
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="CCS Tornitech C.A. <noreply@tornitech.com>"
EMAIL_TO=ventas@tornitech.com
